PORT=4420
DATA_DIR=.data

# Embeddings
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Assistant provider routing
CHAT_PROVIDER=
CHAT_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# API auth
UNIFIED_SEARCH_REQUIRE_AUTH=false
UNIFIED_SEARCH_AUTH_TOKEN=
# Optional JSON map: {"tenant:user":["email","slack"],"tenant:*":["email"],"*:*":["email"]}
UNIFIED_SEARCH_SOURCE_PERMISSIONS=

# Production durability
POSTGRES_CONNECTION_STRING=
POSTGRES_SSL=true
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_SYNC_QUEUE_NAME=unified-search-sync
ARTIFACT_STORAGE_CONNECTION_STRING=
ARTIFACT_BLOB_CONTAINER=unified-search-artifacts
ARTIFACT_PUBLIC_BASE_URL=
UNIFIED_SEARCH_DOCUMENT_RETENTION_DAYS=90
UNIFIED_SEARCH_OPERATIONAL_RETENTION_DAYS=30
UNIFIED_SEARCH_AUDIT_RETENTION_DAYS=90

# Slack personal bot mode
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
SLACK_SYNC_LIMIT=50

# Google Drive OAuth/service config
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_IDS=
GDRIVE_SYNC_LIMIT=50

# Email assistant connector
EMAIL_CONNECTOR_BASE_URL=https://atlas-email-fetcher.proudfield-a201b3fd.eastus.azurecontainerapps.io
EMAIL_CONNECTOR_SESSION_ID=
EMAIL_VECTOR_SEARCH_URL=
EMAIL_CONNECTOR_API_TOKEN=
EMAIL_READINESS_USER_EMAIL=
EMAIL_CONNECTOR_LIMIT=50

# Conference bridge blob connector
AZURE_STORAGE_CONNECTION_STRING=
CONFERENCE_BLOB_CONTAINERS=conference-transcripts
UNIFIED_SEARCH_SMOKE_CONFERENCE_PREFIX=smoke/

# Future connectors
KNOWLEDGE_BASE_ROOT=/app/docs
DATA_FABRIC_BASE_URL=
DATA_FABRIC_API_TOKEN=
DATA_FABRIC_READINESS_PATH=/health
DATA_FABRIC_RECORDS_PATH=/records

# Web defaults for local UI
VITE_UNIFIED_SEARCH_API_BASE=http://localhost:4420
VITE_UNIFIED_SEARCH_TENANT_ID=atlasweb
VITE_UNIFIED_SEARCH_USER_ID=local-user

# Production smoke tests
UNIFIED_SEARCH_BASE_URL=
UNIFIED_SEARCH_SMOKE_MODE=inline
UNIFIED_SEARCH_SMOKE_TENANT_ID=smoke_tenant
UNIFIED_SEARCH_SMOKE_USER_ID=smoke_user
UNIFIED_SEARCH_SMOKE_JOB_POLL_ATTEMPTS=60
UNIFIED_SEARCH_SMOKE_JOB_POLL_INTERVAL_MS=5000

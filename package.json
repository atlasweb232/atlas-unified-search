{
  "name": "atlas-unified-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch src/server.js",
    "dev:web": "vite --host 0.0.0.0 --port 4421 frontend",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:scheduler": "node src/scheduler.js",
    "start:api-scheduler": "node src/apiScheduler.js",
    "build": "vite build frontend",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "audit:production-config": "node scripts/audit-production-config.mjs",
    "wire:production-connectors": "node scripts/wire-production-connectors.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:production:ui": "node scripts/smoke-production-ui.mjs",
    "smoke:local-frontend": "node scripts/smoke-local-frontend-workflows.mjs",
    "smoke:browser-ui": "node scripts/smoke-browser-ui.mjs",
    "seed:fixtures": "node scripts/seed-fixtures.mjs",
    "test": "node scripts/check-specs.mjs && node --test tests/*.test.js",
    "lint": "node scripts/check-specs.mjs"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.27.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.6"
  },
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
}
